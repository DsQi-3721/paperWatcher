{
  "name": "paper-watcher",
  "version": "0.1.0",
  "private": true,
  "description": "A hand-drawn desk for deep-reading papers with a local AI agent",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false server/index.ts",
    "build": "vite build",
    "start": "vite build && tsx server/index.ts --prod --open",
    "serve": "tsx server/index.ts --prod",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@chenglou/pretext": "^1.0.0",
    "@fontsource/architects-daughter": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/kalam": "^5.3.0",
    "@fontsource/long-cang": "^5.3.0",
    "fflate": "^0.8.3",
    "katex": "^0.19.0",
    "lxgw-wenkai-webfont": "^1.7.0",
    "pdfjs-dist": "^6.4.299",
    "perfect-freehand": "^1.2.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
